{
  "$schema": "https://dsh.community/schemas/dsh-plugin-0.15.json",
  "id": "dsh-mcp-registry",
  "name": "dsh-mcp-registry",
  "version": "0.3.14",
  "manifestVersion": "0.15",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": []
  },
  "permissions": [],
  "contributes": {
    "commands": [],
    "x-dsh-tui": [
      {
        "apiVersion": "tui.dsh/v1alpha1",
        "kind": "SettingsSection",
        "id": "dsh-mcp-registry.settings",
        "name": "dsh_mcp_registry_settings",
        "spec": {
          "namespace": "dsh-mcp-registry",
          "title": "MCP 注册表",
          "titles": {
            "en": "MCP Registry",
            "zh": "MCP 注册表"
          },
          "fields": [
            {
              "path": [
                "enabled"
              ],
              "label": "Master switch",
              "kind": "bool",
              "hint": "Off = mcp_bridge_call refuses and the status tool reports disabled."
            },
            {
              "path": [
                "defaultPermissionMode"
              ],
              "label": "Default permission mode",
              "kind": "select",
              "options": [
                {
                  "value": "review-all",
                  "label": "Review all"
                },
                {
                  "value": "allowlist",
                  "label": "Allowlist"
                },
                {
                  "value": "allow-all",
                  "label": "Allow all (destructive veto retained)"
                }
              ]
            },
            {
              "path": [
                "probeTimeoutMs"
              ],
              "label": "Probe timeout (ms)",
              "kind": "number",
              "hint": "Timeout for one MCP initialize handshake. Probes are manual (/mcp-reg probe)."
            },
            {
              "path": [
                "lazyNativeTools"
              ],
              "label": "Lazy-load native tools",
              "kind": "bool",
              "hint": "Hide non-core tool schemas from the prompt and reveal them via tool_discover / tool_activate. Does not affect MCP tools."
            },
            {
              "path": [
                "lazyEagerIndex"
              ],
              "label": "Eager native tool index",
              "kind": "bool",
              "hint": "On (default): the prompt lists hidden native tools by name so the model can tool_activate directly. Off: the model must call tool_discover first (lower standing token cost)."
            },
            {
              "path": [
                "lazyDescriptionLimit"
              ],
              "label": "Lazy catalog description limit",
              "kind": "number",
              "hint": "Max characters per tool description in the tool_discover list."
            }
          ]
        }
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/drscrewdriver/dsh-mcp-registry"
  },
  "compat": {
    "hosts": [
      "dsh-tui"
    ]
  }
}
